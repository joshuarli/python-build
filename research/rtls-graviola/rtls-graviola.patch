+pub fn raise_alert_received(py: Python<'_>, alert: AlertDescription) -> PyErr {
+    let (reason, message) = match alert_error(alert) {
+        Some((reason, description)) => (
+            Some(reason),
+            format!("[SSL: {reason}] {description}"),
+        ),
+        None => {
+            let error_code = (20_u64 << 23) | (1000 + u64::from(u8::from(alert)));
+            (None, format!("[SSL] unknown error (0x{error_code:x})"))
+        }
+    };
+    get_exc_type(
+        py,
+        "SSLError",
+        SSL_ERROR_SSL,
+        &message,
+        Some("SSL"),
+        reason,
+        "SSL: ",
+    )
+}
