+
+pub fn raise_cert_verification(py: Python<'_>, message: &str, verify_code: i32) -> PyErr {
+    let verify_message = match verify_code {
+        3 => "unable to get certificate CRL",
+        7 => "certificate signature failure",
+        8 => "CRL signature failure",
+        9 => "certificate is not yet valid",
+        10 => "certificate has expired",
+        11 => "CRL is not yet valid",
+        12 => "CRL has expired",
+        20 => "unable to get local issuer certificate",
+        23 => "certificate revoked",
+        26 => "unsuitable certificate purpose",
+        34 => "unhandled critical extension",
+        41 => "invalid certificate extension",
+        62 => "Hostname mismatch",
+        _ => message,
+    };
+    let kwargs = PyDict::new(py);
+    if let Err(error) = kwargs.set_item("verify_code", verify_code) {
+        return error;
+    }
+    if let Err(error) = kwargs.set_item("verify_message", verify_message) {
+        return error;
+    }
+    let exception = py
+        .import("rtls._exceptions")
+        .and_then(|module| module.getattr("SSLCertVerificationError"))
+        .and_then(|class| class.call((message,), Some(&kwargs)))
+        .and_then(|value| {
+            value.setattr("library", "SSL")?;
+            value.setattr("reason", "CERTIFICATE_VERIFY_FAILED")?;
+            Ok(value)
+        });
+    match exception {
+        Ok(value) => PyErr::from_value(value),
+        Err(error) => error,
+    }
+}
