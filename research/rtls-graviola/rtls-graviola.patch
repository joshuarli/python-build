+    def test_session_resumption(self):
+        for version in (ssl.TLSVersion.TLSv1_2, ssl.TLSVersion.TLSv1_3):
+            with self.subTest(version=version):
+                client_context, server_context, hostname = testing_context()
+                client_context.minimum_version = version
+                client_context.maximum_version = version
+                server_context.minimum_version = version
+                server_context.maximum_version = version
+                server = ThreadedEchoServer(context=server_context, chatty=False)
+                reused = []
+                chains = []
+                with server:
+                    for _ in range(2):
+                        with client_context.wrap_socket(
+                            socket.socket(), server_hostname=hostname
+                        ) as sock:
+                            sock.connect((HOST, server.port))
+                            reused.append(sock._sslobj.session_reused)
+                            chain = sock.get_verified_chain()
+                            self.assertIsNotNone(chain)
+                            chains.append(
+                                tuple(chain)
+                            )
+                            sock.sendall(b"ping\n")
+                            self.assertEqual(sock.recv(1024), b"ping\n")
+                            sock.sendall(b"over\n")
+                self.assertEqual(reused, [False, True])
+                self.assertEqual(chains[0], chains[1])
+                self.assertGreater(len(chains[0]), 1)
