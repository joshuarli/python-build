+import select
+import socket
+import threading
+import time
+import unittest
+from pathlib import Path
+
+import rtls
+from rtls._exceptions import SSLWantReadError
+
+
+class SocketCloseRecordBoundaryTests(unittest.TestCase):
+    def test_close_notify_remains_select_readable_after_buffered_plaintext(self):
+        certdata = Path(__file__).resolve().parent / "certdata"
+        client_context = rtls.SSLContext(rtls.PROTOCOL_TLS_CLIENT)
+        client_context.check_hostname = False
+        client_context.verify_mode = rtls.CERT_NONE
+        server_context = rtls.SSLContext(rtls.PROTOCOL_TLS_SERVER)
+        server_context.load_cert_chain(
+            str(certdata / "leaf_chain.pem"), str(certdata / "leaf_key.pem")
+        )
+
+        client_transport, server_transport = socket.socketpair()
+        client_transport.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 131072)
+        server_transport.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 131072)
+        client_transport.settimeout(3)
+        server_transport.settimeout(3)
+        client = client_context.wrap_socket(
+            client_transport,
+            server_hostname="localhost",
+            do_handshake_on_connect=False,
+        )
+        server = server_context.wrap_socket(
+            server_transport,
+            server_side=True,
+            do_handshake_on_connect=False,
+        )
+        handshake_errors = []
+
+        def handshake_server():
+            try:
+                server.do_handshake()
+            except BaseException as error:
+                handshake_errors.append(error)
+
+        handshake_thread = threading.Thread(target=handshake_server)
+        reader_thread = None
+        client_plain = None
+        read_results = []
+        try:
+            handshake_thread.start()
+            client.do_handshake()
+            handshake_thread.join(3)
+            self.assertFalse(handshake_thread.is_alive())
+            self.assertEqual(handshake_errors, [])
+
+            payload = b"x" * 32768
+            received = bytearray()
+            read_errors = []
+
+            def read_server():
+                try:
+                    deadline = time.monotonic() + 3
+                    while True:
+                        remaining = deadline - time.monotonic()
+                        if remaining <= 0:
+                            raise TimeoutError("TLS close notification was not readable")
+                        readable, _, _ = select.select([server], [], [], remaining)
+                        if not readable:
+                            raise TimeoutError("TLS close notification was not readable")
+                        data = server.recv(1024)
+                        if not data:
+                            break
+                        received.extend(data)
+                    read_results.append(server.unwrap())
+                except BaseException as error:
+                    read_errors.append(error)
+
+            reader_thread = threading.Thread(target=read_server)
+            client.sendall(payload)
+            with self.assertRaises(SSLWantReadError):
+                client._sslobj_internal.unwrap()
+            client._flush_outgoing()
+            reader_thread.start()
+            client_plain = client.unwrap()
+            reader_thread.join(3)
+
+            self.assertFalse(reader_thread.is_alive())
+            self.assertEqual(read_errors, [])
+            self.assertEqual(received, payload)
+            self.assertEqual(len(read_results), 1)
+
+            server_plain = read_results[0]
+            client_plain.sendall(b"clear")
+            self.assertEqual(server_plain.recv(5), b"clear")
+        finally:
+            if client_plain is not None:
+                client_plain.close()
+            else:
+                client.close()
+            if read_results:
+                read_results[0].close()
+            else:
+                server.close()
+            if reader_thread is not None:
+                reader_thread.join(3)
+            handshake_thread.join(3)
