+use crate::error::raise_ssl_error;
+
+pub(crate) struct PendingHello {
+    pub(crate) acceptor: Acceptor,
+    pub(crate) accepted: Option<Accepted>,
+    pub(crate) remaining: Vec<u8>,
+    pub(crate) alert: Vec<u8>,
+}
+
+#[pyclass(frozen)]
+pub struct RustlsServerAcceptor {
+    pub(crate) inner: Mutex<PendingHello>,
+}
+
+#[pymethods]
+impl RustlsServerAcceptor {
+    #[new]
+    fn new() -> Self {
+        Self {
+            inner: Mutex::new(PendingHello {
+                acceptor: Acceptor::default(),
+                accepted: None,
+                remaining: Vec::new(),
+                alert: Vec::new(),
+            }),
+        }
+    }
+
+    fn feed(&self, py: Python<'_>, data: &[u8]) -> PyResult<bool> {
+        let result = py.detach(|| -> Result<bool, String> {
+            let mut state = self.inner.lock().unwrap();
+            let mut cursor = Cursor::new(data);
+            loop {
+                if state.accepted.is_some() {
+                    state.remaining.extend_from_slice(&data[cursor.position() as usize..]);
+                    return Ok(true);
+                }
+                if cursor.position() == data.len() as u64 {
+                    return Ok(false);
+                }
+                let n = state.acceptor.read_tls(&mut cursor).map_err(|e| e.to_string())?;
+                match state.acceptor.accept() {
+                    Ok(Some(accepted)) => state.accepted = Some(accepted),
+                    Ok(None) if n == 0 => return Ok(false),
+                    Ok(None) => (),
+                    Err((error, mut alert)) => {
+                        alert.write_all(&mut state.alert).map_err(|e| e.to_string())?;
+                        return Err(error.to_string());
+                    }
+                }
+            }
+        });
+        result.map_err(|message| raise_ssl_error(py, &message))
+    }
+
+    fn server_name(&self) -> Option<String> {
+        self.inner.lock().unwrap().accepted.as_ref()
+            .and_then(|accepted| accepted.client_hello().server_name().map(str::to_owned))
+    }
+
+    fn take_alert(&self, py: Python<'_>) -> Py<PyAny> {
+        let alert = std::mem::take(&mut self.inner.lock().unwrap().alert);
+        PyBytes::new(py, &alert).into()
+    }
+
+    fn reject(&self, py: Python<'_>, alert: u8) -> PyResult<Py<PyAny>> {
+        let mut state = self.inner.lock().unwrap();
+        let accepted = state.accepted.take()
+            .ok_or_else(|| raise_ssl_error(py, "ClientHello is not available"))?;
+        let mut rejected = accepted.reject(rustls::AlertDescription::from(alert));
+        let mut output = Vec::new();
+        rejected.write_all(&mut output).map_err(|e| raise_ssl_error(py, &e.to_string()))?;
+        Ok(PyBytes::new(py, &output).into())
+    }
+}
+
+#[pyfunction]
+pub fn report_callback_error(py: Python<'_>, error: Bound<'_, PyAny>, callback: Bound<'_, PyAny>) {
+    PyErr::from_value(error).write_unraisable(py, Some(&callback));
+}
