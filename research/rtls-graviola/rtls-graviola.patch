+import socket
+import threading
+import unittest
+from pathlib import Path
+
+import rtls
+from rtls._exceptions import SSLWantReadError, SSLWantWriteError
+
+
+class HandshakeRecordBoundaryTests(unittest.TestCase):
+    def _contexts(self):
+        certdata = Path(__file__).resolve().parent / "certdata"
+        client_context = rtls.SSLContext(rtls.PROTOCOL_TLS_CLIENT)
+        client_context.check_hostname = False
+        client_context.verify_mode = rtls.CERT_NONE
+        server_context = rtls.SSLContext(rtls.PROTOCOL_TLS_SERVER)
+        server_context.load_cert_chain(
+            str(certdata / "leaf_chain.pem"), str(certdata / "leaf_key.pem")
+        )
+        return client_context, server_context
+
+    def test_handshake_leaves_coalesced_application_record_readable(self):
+        client_context, server_context = self._contexts()
+        client_transport, server_transport = socket.socketpair()
+        client_transport.settimeout(3)
+        server_transport.settimeout(3)
+        incoming = rtls.MemoryBIO()
+        outgoing = rtls.MemoryBIO()
+        client = client_context.wrap_bio(
+            incoming, outgoing, server_hostname="localhost"
+        )
+        server = server_context.wrap_socket(
+            server_transport, server_side=True, do_handshake_on_connect=False
+        )
+        server_errors = []
+
+        def handshake_server():
+            try:
+                server.do_handshake()
+            except BaseException as error:
+                server_errors.append(error)
+
+        server_thread = threading.Thread(target=handshake_server)
+        try:
+            with self.assertRaises(SSLWantReadError):
+                client.do_handshake()
+            client_transport.sendall(outgoing.read())
+            server_thread.start()
+
+            while True:
+                try:
+                    client.do_handshake()
+                    break
+                except SSLWantReadError:
+                    incoming.write(client_transport.recv(65536))
+                except SSLWantWriteError:
+                    client_transport.sendall(outgoing.read())
+
+            request = b"DELE foo\r\n"
+            client.write(request)
+            client_transport.sendall(outgoing.read())
+            server_thread.join(5)
+
+            self.assertFalse(server_thread.is_alive())
+            self.assertEqual(server_errors, [])
+            self.assertEqual(server.pending(), 0)
+            self.assertEqual(server.recv(len(request)), request)
+        finally:
+            client_transport.close()
+            server.close()
+            if server_thread.is_alive():
+                server_thread.join(5)
+
+    def test_nonblocking_handshake_accepts_fragmented_record(self):
+        client_context, server_context = self._contexts()
+        client_transport, server_transport = socket.socketpair()
+        client_transport.settimeout(3)
+        server_transport.setblocking(False)
+        incoming = rtls.MemoryBIO()
+        outgoing = rtls.MemoryBIO()
+        client = client_context.wrap_bio(
+            incoming, outgoing, server_hostname="localhost"
+        )
+        server = server_context.wrap_socket(
+            server_transport, server_side=True, do_handshake_on_connect=False
+        )
+        try:
+            with self.assertRaises(SSLWantReadError):
+                client.do_handshake()
+            client_hello = outgoing.read()
+            fragments = (
+                client_hello[:2],
+                client_hello[2:5],
+                client_hello[5:17],
+                client_hello[17:],
+            )
+            for fragment in fragments:
+                client_transport.sendall(fragment)
+                with self.assertRaises(SSLWantReadError):
+                    server.do_handshake()
+            server_flight = client_transport.recv(65536)
+            self.assertTrue(server_flight)
+        finally:
+            client_transport.close()
+            server.close()
+
+    def test_invalid_record_header_fails_before_body_arrives(self):
+        _, server_context = self._contexts()
+        for header in (b"GET /", b"\x16\x03\x03\xff\xff"):
+            with self.subTest(header=header):
+                client_transport, server_transport = socket.socketpair()
+                client_transport.settimeout(1)
+                server_transport.settimeout(1)
+                server = server_context.wrap_socket(
+                    server_transport,
+                    server_side=True,
+                    do_handshake_on_connect=False,
+                )
+                try:
+                    client_transport.sendall(header)
+                    with self.assertRaises(rtls.SSLError):
+                        server.do_handshake()
+                finally:
+                    client_transport.close()
+                    server.close()
+
