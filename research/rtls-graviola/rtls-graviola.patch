+    fn id<'py>(&self, py: Python<'py>) -> Bound<'py, PyBytes> {
+        PyBytes::new(py, &self.data.metadata.id)
+    }
+
+    #[getter]
+    fn time(&self) -> u64 {
+        self.data.metadata.time
+    }
+
+    #[getter]
+    fn timeout(&self) -> u32 {
+        self.data.metadata.timeout
+    }
+
+    #[getter]
+    fn has_ticket(&self) -> bool {
+        self.data.metadata.has_ticket
+    }
+
+    #[getter]
+    fn ticket_lifetime_hint(&self) -> u32 {
+        self.data.metadata.ticket_lifetime_hint
+    }
+
+    fn __repr__(&self) -> &'static str {
+        "<SSLSession>"
+    }
+
+    fn __richcmp__(
+        &self,
+        other: &Bound<'_, PyAny>,
+        op: CompareOp,
+        py: Python<'_>,
+    ) -> Py<PyAny> {
+        let Ok(other) = other.extract::<PyRef<'_, RustlsSession>>() else {
+            return py.NotImplemented();
+        };
+        let equal = self.data.metadata.id == other.data.metadata.id;
+        match op {
+            CompareOp::Eq => equal,
+            CompareOp::Ne => !equal,
+            _ => return py.NotImplemented(),
+        }
+        .into_pyobject(py)
+        .unwrap()
+        .to_owned()
+        .into_any()
+        .unbind()
+    }
+}
+
+thread_local! {
+    static SESSION_CAPTURE: RefCell<Option<Arc<Mutex<Option<Arc<SessionData>>>>>> = const { RefCell::new(None) };
+    static SESSION_OVERRIDE: RefCell<Option<Arc<ExplicitSession>>> = const { RefCell::new(None) };
+}
+
+pub(crate) struct SessionCapture {
+    previous: Option<Arc<Mutex<Option<Arc<SessionData>>>>>,
+    _not_send: PhantomData<Rc<()>>,
+}
+
+impl SessionCapture {
+    pub(crate) fn enter(target: Arc<Mutex<Option<Arc<SessionData>>>>) -> Self {
+        let previous = SESSION_CAPTURE.with(|current| current.replace(Some(target)));
+        Self {
+            previous,
+            _not_send: PhantomData,
+        }
+    }
+}
+
+impl Drop for SessionCapture {
+    fn drop(&mut self) {
+        let previous = self.previous.take();
+        SESSION_CAPTURE.with(|current| {
+            current.replace(previous);
+        });
+    }
+}
+
+pub(crate) fn capture_current_session(session: Arc<SessionData>) {
+    SESSION_CAPTURE.with(|current| {
+        if let Some(target) = current.borrow().as_ref() {
+            *target.lock().unwrap() = Some(session);
+        }
+    });
+}
+
+pub(crate) struct SessionOverride {
+    previous: Option<Arc<ExplicitSession>>,
+    _not_send: PhantomData<Rc<()>>,
