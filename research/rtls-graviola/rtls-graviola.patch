+    def test_explicit_session(self):
+        for version in (ssl.TLSVersion.TLSv1_2, ssl.TLSVersion.TLSv1_3):
+            with self.subTest(version=version):
+                client_context, server_context, hostname = testing_context()
+                client_context.minimum_version = version
+                client_context.maximum_version = version
+                server_context.minimum_version = version
+                server_context.maximum_version = version
+
+                first = server_params_test(
+                    client_context,
+                    server_context,
+                    chatty=False,
+                    sni_name=hostname,
+                )
+                session = first["session"]
+                self.assertIsInstance(session, ssl.SSLSession)
+                self.assertIsInstance(session.id, bytes)
+                self.assertGreater(session.time, 0)
+                self.assertGreater(session.timeout, 0)
+                self.assertTrue(session.has_ticket)
+                self.assertGreater(session.ticket_lifetime_hint, 0)
+                self.assertFalse(first["session_reused"])
+                first_stats = server_context.session_stats()
+                self.assertEqual(first_stats["accept"], 1)
+                self.assertEqual(first_stats["accept_good"], 1)
+                self.assertEqual(first_stats["hits"], 0)
+
+                resumed = server_params_test(
+                    client_context,
+                    server_context,
+                    chatty=False,
+                    sni_name=hostname,
+                    session=session,
+                )
+                self.assertTrue(resumed["session_reused"])
+                self.assertIsInstance(resumed["session"], ssl.SSLSession)
+                resumed_stats = server_context.session_stats()
+                self.assertEqual(resumed_stats["accept"], 2)
+                self.assertEqual(resumed_stats["accept_good"], 2)
+                self.assertEqual(resumed_stats["hits"], 1)
+
+                full_handshake = server_params_test(
+                    client_context,
+                    server_context,
+                    chatty=False,
+                    sni_name=hostname,
+                )
+                self.assertFalse(full_handshake["session_reused"])
+                if version is ssl.TLSVersion.TLSv1_2:
+                    self.assertNotEqual(full_handshake["session"].id, session.id)
+                full_stats = server_context.session_stats()
+                self.assertEqual(full_stats["accept"], 3)
+                self.assertEqual(full_stats["hits"], 1)
+
+                if version is ssl.TLSVersion.TLSv1_3:
+                    with self.assertRaisesRegex(
+                        ValueError, "TLS 1.3 session ticket has already been used"
+                    ):
+                        server_params_test(
+                            client_context,
+                            server_context,
+                            chatty=False,
+                            sni_name=hostname,
+                            session=session,
+                        )
+                else:
+                    repeated = server_params_test(
+                        client_context,
+                        server_context,
+                        chatty=False,
+                        sni_name=hostname,
+                        session=session,
+                    )
+                    self.assertTrue(repeated["session_reused"])
+                    self.assertEqual(repeated["session"], session)
+                    repeated_stats = server_context.session_stats()
+                    self.assertEqual(repeated_stats["accept"], 4)
+                    self.assertEqual(repeated_stats["hits"], 2)
+
