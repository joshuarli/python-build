+        let mut snapshot = self.clone_builder(py);
+        snapshot.server_sessions = Arc::clone(&self.server_sessions);
+        snapshot.server_ticketer = Arc::clone(&self.server_ticketer);
+        snapshot
+    }
+
+    fn validate_server_hello(
+        &self,
+        py: Python<'_>,
+        acceptor: &crate::sni::RustlsServerAcceptor,
+    ) -> PyResult<()> {
+        let result = py.detach(|| -> Result<(), String> {
+            let versions = self.get_protocol_versions()?;
+            let mut state = acceptor.inner.lock().unwrap();
+            let accepted = state.accepted.as_ref().ok_or("ClientHello is not available")?;
+            if versions.iter().any(|version| accepted.offers_protocol_version(version.version)) {
+                return Ok(());
+            }
+            let mut alert = state.accepted.take().unwrap()
+                .reject(rustls::AlertDescription::ProtocolVersion);
+            alert.write_all(&mut state.alert).map_err(|e| e.to_string())?;
+            Err("UNSUPPORTED_PROTOCOL".into())
+        });
+        result.map_err(|message| raise_ssl_error(py, &message))
+    }
+
+    fn accept_server_connection(
+        &self,
+        py: Python<'_>,
+        acceptor: &crate::sni::RustlsServerAcceptor,
+        selected_context: &RustlsConfigBuilder,
+    ) -> PyResult<RustlsServerConnection> {
+        let result = py.detach(|| -> Result<RustlsServerConnection, AcceptorError> {
+            let mut config = self.build_server_config_for_context(selected_context)?;
+            let mut state = acceptor.inner.lock().unwrap();
+            let accepted = state.accepted.take().ok_or("ClientHello is not available")?;
+            {
+                let hello = accepted.client_hello();
+                if let Some(mut offered) = hello.alpn() {
+                    if !offered.any(|protocol| config.alpn_protocols.iter().any(|configured| configured == protocol)) {
+                        config.alpn_protocols.clear();
+                    }
+                }
+            }
+            let verified_chain: VerifiedChain = Arc::new(Mutex::new(None));
+            let _capture = VerificationCapture::enter(Arc::clone(&verified_chain));
+            let mut conn = match accepted.into_connection(Arc::new(config)) {
+                Ok(conn) => conn,
+                Err((error, mut alert)) => {
+                    alert.write_all(&mut state.alert).map_err(|e| e.to_string())?;
+                    return Err(AcceptorError::Rustls(error));
+                }
+            };
+            let mut pending = std::io::Cursor::new(std::mem::take(&mut state.remaining));
+            while pending.position() < pending.get_ref().len() as u64 {
+                if conn.read_tls(&mut pending).map_err(|e| e.to_string())? == 0 {
+                    return Err("server did not consume buffered TLS records".into());
+                }
+            }
+            Ok(RustlsServerConnection::new(conn, verified_chain, Arc::clone(&self.session_stats)))
+        });
+        result.map_err(|error| match error {
+            AcceptorError::Rustls(error) => raise_rustls_error(py, error),
+            AcceptorError::General(message) => raise_ssl_error(py, &message),
+        })
+    }
+
+}
+
+enum AcceptorError {
+    Rustls(rustls::Error),
+    General(String),
+}
+
+impl From<String> for AcceptorError {
+    fn from(message: String) -> Self {
+        Self::General(message)
+    }
+}
+
+impl From<&str> for AcceptorError {
+    fn from(message: &str) -> Self {
+        Self::General(message.to_string())
+    }
