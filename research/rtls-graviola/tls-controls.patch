+fn group_from_name(name: &str) -> Option<NamedGroup> {
+    match name.to_ascii_lowercase().as_str() {
+        "x25519" => Some(NamedGroup::X25519),
+        "secp256r1" | "prime256v1" | "p-256" | "nistp256" => {
+            Some(NamedGroup::secp256r1)
+        }
+        "secp384r1" | "p-384" | "nistp384" => Some(NamedGroup::secp384r1),
+        "x25519mlkem768" | "x25519_mlkem768" => Some(NamedGroup::X25519MLKEM768),
+        _ => None,
+    }
+}
+
+fn group_iana_name(group: NamedGroup) -> Option<&'static str> {
+    match group {
+        NamedGroup::X25519 => Some("x25519"),
+        NamedGroup::secp256r1 => Some("secp256r1"),
+        NamedGroup::secp384r1 => Some("secp384r1"),
+        NamedGroup::X25519MLKEM768 => Some("x25519_mlkem768"),
+        _ => None,
+    }
+}
+
+fn group_aliases(group: NamedGroup) -> &'static [&'static str] {
+    match group {
+        NamedGroup::secp256r1 => &["P-256", "prime256v1", "NISTP256"],
+        NamedGroup::secp384r1 => &["P-384", "NISTP384"],
+        NamedGroup::X25519 => &["X25519"],
+        NamedGroup::X25519MLKEM768 => &["X25519MLKEM768"],
+        _ => &[],
+    }
+}
+
+fn parse_groups(names: &str) -> Result<Vec<NamedGroup>, String> {
+    let mut groups = Vec::new();
+    for token in names.split(':') {
+        if token.is_empty() {
+            return Err("Empty TLS group name".to_string());
+        }
+        let (optional, name) = match token.strip_prefix('?') {
+            Some(name) if !name.is_empty() => (true, name),
+            Some(_) => return Err("Empty TLS group name".to_string()),
+            None => (false, token),
+        };
+        let group = group_from_name(name);
+        let available = group.filter(|group| {
+            PREFERRED_KX_GROUPS.iter().any(|supported| supported.name() == *group)
+        });
+        match available {
+            Some(group) if !groups.contains(&group) => groups.push(group),
+            Some(_) => {}
+            None if optional => {}
+            None => return Err(format!("Unsupported TLS group: {name}")),
+        }
+    }
+    if groups.is_empty() {
+        return Err("No supported TLS groups selected".to_string());
+    }
+    Ok(groups)
+}
+
+fn signature_scheme_name(scheme: SignatureScheme) -> Option<&'static str> {
+    match scheme {
+        SignatureScheme::ECDSA_NISTP256_SHA256 => Some("ecdsa_secp256r1_sha256"),
+        SignatureScheme::ECDSA_NISTP384_SHA384 => Some("ecdsa_secp384r1_sha384"),
+        SignatureScheme::ED25519 => Some("ed25519"),
+        SignatureScheme::RSA_PSS_SHA256 => Some("rsa_pss_rsae_sha256"),
+        SignatureScheme::RSA_PSS_SHA384 => Some("rsa_pss_rsae_sha384"),
+        SignatureScheme::RSA_PSS_SHA512 => Some("rsa_pss_rsae_sha512"),
+        SignatureScheme::RSA_PKCS1_SHA256 => Some("rsa_pkcs1_sha256"),
+        SignatureScheme::RSA_PKCS1_SHA384 => Some("rsa_pkcs1_sha384"),
+        SignatureScheme::RSA_PKCS1_SHA512 => Some("rsa_pkcs1_sha512"),
+        _ => None,
+    }
+}
+
+fn signature_scheme_from_name(name: &str) -> Option<SignatureScheme> {
+    match name.to_ascii_lowercase().as_str() {
+        "ecdsa_secp256r1_sha256" => Some(SignatureScheme::ECDSA_NISTP256_SHA256),
+        "ecdsa_secp384r1_sha384" => Some(SignatureScheme::ECDSA_NISTP384_SHA384),
+        "ed25519" => Some(SignatureScheme::ED25519),
+        "rsa_pss_rsae_sha256" => Some(SignatureScheme::RSA_PSS_SHA256),
+        "rsa_pss_rsae_sha384" => Some(SignatureScheme::RSA_PSS_SHA384),
+        "rsa_pss_rsae_sha512" => Some(SignatureScheme::RSA_PSS_SHA512),
+        "rsa_pkcs1_sha256" => Some(SignatureScheme::RSA_PKCS1_SHA256),
+        "rsa_pkcs1_sha384" => Some(SignatureScheme::RSA_PKCS1_SHA384),
+        "rsa_pkcs1_sha512" => Some(SignatureScheme::RSA_PKCS1_SHA512),
+        _ => None,
+    }
+}
+
+fn supported_signature_schemes() -> Vec<SignatureScheme> {
+    default_crypto_provider()
+        .signature_verification_algorithms
+        .supported_schemes()
+}
+
+fn parse_signature_schemes(names: &str) -> Result<Vec<SignatureScheme>, String> {
+    let supported = supported_signature_schemes();
+    let mut schemes = Vec::new();
+    for token in names.split(':') {
+        if token.is_empty() {
+            return Err("Empty TLS signature algorithm name".to_string());
+        }
+        let (optional, name) = match token.strip_prefix('?') {
+            Some(name) if !name.is_empty() => (true, name),
+            Some(_) => return Err("Empty TLS signature algorithm name".to_string()),
+            None => (false, token),
+        };
+        match signature_scheme_from_name(name).filter(|scheme| supported.contains(scheme)) {
+            Some(scheme) if !schemes.contains(&scheme) => schemes.push(scheme),
+            Some(_) => {}
+            None if optional => {}
+            None => return Err(format!("Unsupported TLS signature algorithm: {name}")),
+        }
+    }
+    if schemes.is_empty() {
+        return Err("No supported TLS signature algorithms selected".to_string());
+    }
+    Ok(schemes)
+}
