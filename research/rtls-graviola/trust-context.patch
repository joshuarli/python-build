+        with os.scandir(capath) as entries:
+            for entry in entries:
+                match = re.fullmatch(r"([0-9a-f]{8})\.([0-9]+)", entry.name)
+                if match is None or len(match.group(2)) > 9 or not entry.is_file():
+                    continue
