+#ifdef __FILC__
+    /* The bundled Pizfix loader receives python3.14.real as argv[0]. The
+       launcher supplies the public executable path in PYTHONEXECUTABLE;
+       preserve that spelling in sys.orig_argv as well as sys.executable. */
+    const char *filc_launcher = getenv("PYTHONEXECUTABLE");
+    if (filc_launcher != NULL && config->orig_argv.length > 0) {
+        wchar_t *launcher_argv = Py_DecodeLocale(filc_launcher, NULL);
+        if (launcher_argv == NULL) {
+            return _PyStatus_NO_MEMORY();
+        }
+        PyMem_RawFree(config->orig_argv.items[0]);
+        config->orig_argv.items[0] = launcher_argv;
+    }
+#endif
