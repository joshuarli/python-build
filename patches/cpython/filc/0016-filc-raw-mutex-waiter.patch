+#ifdef __FILC__
+    void *locked = (void *)_Py_LOCKED;
+    if (_Py_atomic_compare_exchange_ptr(&m->v, &locked, NULL)) {
+#else
     uintptr_t locked = _Py_LOCKED;
     if (_Py_atomic_compare_exchange_uintptr(&m->v, &locked, _Py_UNLOCKED)) {
+#endif
         return;
