 {
+#ifdef __FILC__
+    void *unlocked = NULL;
+    if (_Py_atomic_compare_exchange_ptr(&m->v, &unlocked, (void *)_Py_LOCKED)) {
+#else
     uintptr_t unlocked = _Py_UNLOCKED;
     if (_Py_atomic_compare_exchange_uintptr(&m->v, &unlocked, _Py_LOCKED)) {
+#endif
         return;
     }
     _PyRawMutex_LockSlow(m);
