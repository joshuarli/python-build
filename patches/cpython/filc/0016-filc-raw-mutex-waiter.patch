 // indicate whether the mutex is locked or not. The remaining bits are either
 // zero or a pointer to a `struct raw_mutex_entry` (see lock.c).
 typedef struct {
+#ifdef __FILC__
+    void *v;
+#else
     uintptr_t v;
+#endif
 } _PyRawMutex;
 
