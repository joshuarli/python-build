diff --git a/Modules/_rust_shlex_split/module.c b/Modules/_rust_shlex_split/module.c
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_shlex_split/module.c
@@ -0,0 +1,79 @@
+/* CPython owns Unicode and token objects; Rust scans exact ASCII text. */
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+
+extern int shlex_split_scan(const unsigned char *, Py_ssize_t,
+                           unsigned char *, Py_ssize_t *, Py_ssize_t *);
+
+static PyObject *scan(PyObject *self, PyObject *arg)
+{
+    Py_ssize_t length, count = 0, offset = 0;
+    unsigned char *buffer;
+    Py_ssize_t *lengths;
+    PyObject *tokens;
+    (void)self;
+    if (!PyUnicode_CheckExact(arg)) {
+        PyErr_SetString(PyExc_TypeError, "scan requires exact str");
+        return NULL;
+    }
+    if (!PyUnicode_IS_ASCII(arg)) {
+        Py_RETURN_NONE;
+    }
+    length = PyUnicode_GET_LENGTH(arg);
+    /* Command-sized inputs bound temporary token-length storage. */
+    if (length > 4096) {
+        Py_RETURN_NONE;
+    }
+    buffer = PyMem_Malloc((size_t)length + 1);
+    lengths = PyMem_Malloc(((size_t)length + 1) * sizeof(Py_ssize_t));
+    if (buffer == NULL || lengths == NULL) {
+        PyMem_Free(buffer);
+        PyMem_Free(lengths);
+        return PyErr_NoMemory();
+    }
+    if (!shlex_split_scan((const unsigned char *)PyUnicode_1BYTE_DATA(arg),
+                          length, buffer, lengths, &count)) {
+        PyMem_Free(buffer);
+        PyMem_Free(lengths);
+        Py_RETURN_NONE;
+    }
+    tokens = PyList_New(count);
+    if (tokens != NULL) {
+        for (Py_ssize_t index = 0; index < count; index++) {
+            PyObject *token = PyUnicode_FromStringAndSize(
+                (const char *)buffer + offset, lengths[index]);
+            if (token == NULL) {
+                Py_CLEAR(tokens);
+                break;
+            }
+            PyList_SET_ITEM(tokens, index, token);
+            offset += lengths[index];
+        }
+    }
+    PyMem_Free(buffer);
+    PyMem_Free(lengths);
+    return tokens;
+}
+
+static PyMethodDef methods[] = {
+    {"scan", scan, METH_O, "Return POSIX shell tokens or None for fallback."},
+    {NULL, NULL, 0, NULL}
+};
+
+static PyModuleDef_Slot slots[] = {
+    {Py_mod_multiple_interpreters, Py_MOD_PER_INTERPRETER_GIL_SUPPORTED},
+    {0, NULL}
+};
+
+static struct PyModuleDef module = {
+    PyModuleDef_HEAD_INIT,
+    .m_name = "_rust_shlex_split",
+    .m_size = 0,
+    .m_methods = methods,
+    .m_slots = slots,
+};
+
+PyMODINIT_FUNC PyInit__rust_shlex_split(void)
+{
+    return PyModuleDef_Init(&module);
+}
diff --git a/Modules/_rust_shlex_split/scan.rs b/Modules/_rust_shlex_split/scan.rs
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_shlex_split/scan.rs
@@ -0,0 +1,93 @@
+#![no_std]
+
+use core::panic::PanicInfo;
+
+unsafe extern "C" {
+    fn abort() -> !;
+}
+
+#[panic_handler]
+fn panic(_info: &PanicInfo<'_>) -> ! {
+    unsafe { abort() }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn shlex_split_scan(
+    input: *const u8,
+    length: isize,
+    output: *mut u8,
+    lengths: *mut isize,
+    count_out: *mut isize,
+) -> i32 {
+    if input.is_null() || output.is_null() || lengths.is_null()
+        || count_out.is_null() || length < 0
+    {
+        return 0;
+    }
+    let source = unsafe { core::slice::from_raw_parts(input, length as usize) };
+    let mut index = 0usize;
+    let mut used = 0usize;
+    let mut start = 0usize;
+    let mut count = 0usize;
+    let mut active = false;
+    let mut quote = 0u8;
+    while index < source.len() {
+        let Some(&byte) = source.get(index) else { return 0 };
+        index += 1;
+        if quote == b'\'' {
+            if byte == b'\'' {
+                quote = 0;
+            } else {
+                unsafe { *output.add(used) = byte };
+                used += 1;
+            }
+            continue;
+        }
+        if quote == b'"' {
+            if byte == b'"' {
+                quote = 0;
+            } else if byte == b'\\' {
+                let Some(&next) = source.get(index) else { return 0 };
+                index += 1;
+                if next != b'"' && next != b'\\' {
+                    unsafe { *output.add(used) = b'\\' };
+                    used += 1;
+                }
+                unsafe { *output.add(used) = next };
+                used += 1;
+            } else {
+                unsafe { *output.add(used) = byte };
+                used += 1;
+            }
+            continue;
+        }
+        if byte == b' ' || byte == b'\t' || byte == b'\r' || byte == b'\n' {
+            if active {
+                unsafe { *lengths.add(count) = (used - start) as isize };
+                count += 1;
+                start = used;
+                active = false;
+            }
+        } else if byte == b'\'' || byte == b'"' {
+            quote = byte;
+            active = true;
+        } else if byte == b'\\' {
+            let Some(&next) = source.get(index) else { return 0 };
+            index += 1;
+            unsafe { *output.add(used) = next };
+            used += 1;
+            active = true;
+        } else {
+            unsafe { *output.add(used) = byte };
+            used += 1;
+            active = true;
+        }
+    }
+    if quote != 0 { return 0 }
+    if active {
+        unsafe { *lengths.add(count) = (used - start) as isize };
+        count += 1;
+    }
+    unsafe { *count_out = count as isize };
+    1
+}
