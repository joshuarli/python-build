diff --git a/Modules/_rust_uuid_canonical/module.c b/Modules/_rust_uuid_canonical/module.c
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_uuid_canonical/module.c
@@ -0,0 +1,45 @@
+/* The public UUID constructor retains object creation and fallback policy. */
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+#include <stdint.h>
+
+extern int uuid_canonical_scan(const unsigned char *, Py_ssize_t, uint8_t *);
+
+static PyObject *scan(PyObject *self, PyObject *arg)
+{
+    uint8_t bytes[16];
+    (void)self;
+    if (!PyUnicode_CheckExact(arg)) {
+        PyErr_SetString(PyExc_TypeError, "scan requires exact str");
+        return NULL;
+    }
+    if (!PyUnicode_IS_ASCII(arg) ||
+        !uuid_canonical_scan((const unsigned char *)PyUnicode_1BYTE_DATA(arg),
+                             PyUnicode_GET_LENGTH(arg), bytes)) {
+        Py_RETURN_NONE;
+    }
+    return PyLong_FromUnsignedNativeBytes(bytes, 16, Py_ASNATIVEBYTES_BIG_ENDIAN);
+}
+
+static PyMethodDef methods[] = {
+    {"scan", scan, METH_O, "Return a canonical UUID integer or None."},
+    {NULL, NULL, 0, NULL}
+};
+
+static PyModuleDef_Slot slots[] = {
+    {Py_mod_multiple_interpreters, Py_MOD_PER_INTERPRETER_GIL_SUPPORTED},
+    {0, NULL}
+};
+
+static struct PyModuleDef module = {
+    PyModuleDef_HEAD_INIT,
+    .m_name = "_rust_uuid_canonical",
+    .m_size = 0,
+    .m_methods = methods,
+    .m_slots = slots,
+};
+
+PyMODINIT_FUNC PyInit__rust_uuid_canonical(void)
+{
+    return PyModuleDef_Init(&module);
+}
diff --git a/Modules/_rust_uuid_canonical/scan.rs b/Modules/_rust_uuid_canonical/scan.rs
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_uuid_canonical/scan.rs
@@ -0,0 +1,57 @@
+#![no_std]
+
+use core::panic::PanicInfo;
+
+unsafe extern "C" {
+    fn abort() -> !;
+}
+
+#[panic_handler]
+fn panic(_info: &PanicInfo<'_>) -> ! {
+    unsafe { abort() }
+}
+
+fn nibble(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        _ => None,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn uuid_canonical_scan(
+    input: *const u8,
+    length: isize,
+    output: *mut u8,
+) -> i32 {
+    if input.is_null() || output.is_null() || length != 36 {
+        return 0;
+    }
+    let bytes = unsafe { core::slice::from_raw_parts(input, 36) };
+    if bytes[8] != b'-' || bytes[13] != b'-' || bytes[18] != b'-' || bytes[23] != b'-' {
+        return 0;
+    }
+    let mut value = [0u8; 16];
+    let mut index = 0;
+    let mut digits = 0;
+    while index < 36 {
+        if index == 8 || index == 13 || index == 18 || index == 23 {
+            index += 1;
+            continue;
+        }
+        let (Some(&first), Some(&second), Some(out)) = (
+            bytes.get(index), bytes.get(index + 1), value.get_mut(digits),
+        ) else {
+            return 0;
+        };
+        let (Some(high), Some(low)) = (nibble(first), nibble(second)) else {
+            return 0;
+        };
+        *out = (high << 4) | low;
+        digits += 1;
+        index += 2;
+    }
+    unsafe { core::ptr::copy_nonoverlapping(value.as_ptr(), output, 16) };
+    1
+}
