diff --git a/Modules/_rust_fraction_rational/module.c b/Modules/_rust_fraction_rational/module.c
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_fraction_rational/module.c
@@ -0,0 +1,46 @@
+/* CPython owns integer and Fraction objects; Rust scans bounded ASCII text. */
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+#include <stdint.h>
+
+extern int fraction_rational_scan(const unsigned char *, Py_ssize_t,
+                                  int64_t *, int64_t *);
+
+static PyObject *scan(PyObject *self, PyObject *arg)
+{
+    int64_t numerator, denominator;
+    (void)self;
+    if (!PyUnicode_CheckExact(arg)) {
+        PyErr_SetString(PyExc_TypeError, "scan requires exact str");
+        return NULL;
+    }
+    if (!PyUnicode_IS_ASCII(arg) ||
+        !fraction_rational_scan((const unsigned char *)PyUnicode_1BYTE_DATA(arg),
+                                PyUnicode_GET_LENGTH(arg), &numerator, &denominator)) {
+        Py_RETURN_NONE;
+    }
+    return Py_BuildValue("(LL)", (long long)numerator, (long long)denominator);
+}
+
+static PyMethodDef methods[] = {
+    {"scan", scan, METH_O, "Return two canonical rational integers or None."},
+    {NULL, NULL, 0, NULL}
+};
+
+static PyModuleDef_Slot slots[] = {
+    {Py_mod_multiple_interpreters, Py_MOD_PER_INTERPRETER_GIL_SUPPORTED},
+    {0, NULL}
+};
+
+static struct PyModuleDef module = {
+    PyModuleDef_HEAD_INIT,
+    .m_name = "_rust_fraction_rational",
+    .m_size = 0,
+    .m_methods = methods,
+    .m_slots = slots,
+};
+
+PyMODINIT_FUNC PyInit__rust_fraction_rational(void)
+{
+    return PyModuleDef_Init(&module);
+}
diff --git a/Modules/_rust_fraction_rational/scan.rs b/Modules/_rust_fraction_rational/scan.rs
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_fraction_rational/scan.rs
@@ -0,0 +1,65 @@
+#![no_std]
+
+use core::panic::PanicInfo;
+
+unsafe extern "C" {
+    fn abort() -> !;
+}
+
+#[panic_handler]
+fn panic(_info: &PanicInfo<'_>) -> ! {
+    unsafe { abort() }
+}
+
+fn digits(bytes: &[u8]) -> Option<i64> {
+    if bytes.is_empty() || bytes.len() > 18 {
+        return None;
+    }
+    let mut value = 0_i64;
+    for &byte in bytes {
+        if !byte.is_ascii_digit() {
+            return None;
+        }
+        value = value * 10 + i64::from(byte - b'0');
+    }
+    Some(value)
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn fraction_rational_scan(
+    input: *const u8,
+    length: isize,
+    numerator: *mut i64,
+    denominator: *mut i64,
+) -> i32 {
+    if input.is_null() || numerator.is_null() || denominator.is_null()
+        || !(3..=38).contains(&length)
+    {
+        return 0;
+    }
+    let bytes = unsafe { core::slice::from_raw_parts(input, length as usize) };
+    let Some(&first) = bytes.first() else { return 0 };
+    let offset = usize::from(first == b'-');
+    let Some(slash) = bytes.iter().position(|&byte| byte == b'/') else {
+        return 0;
+    };
+    let (Some(left_bytes), Some(right_bytes)) =
+        (bytes.get(offset..slash), bytes.get(slash + 1..))
+    else {
+        return 0;
+    };
+    let (Some(mut left), Some(right)) = (digits(left_bytes), digits(right_bytes)) else {
+        return 0;
+    };
+    if right == 0 {
+        return 0;
+    }
+    if offset == 1 {
+        left = -left;
+    }
+    unsafe {
+        *numerator = left;
+        *denominator = right;
+    }
+    1
+}
