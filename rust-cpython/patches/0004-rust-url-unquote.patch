-//! Exact-byte percent quoting for the guarded urllib.parse overlay.
+//! Percent-byte scans for CPython URL quotation and decoding.
 //!
-//! A null output requests the required length. The C caller then allocates an
-//! exact-size ASCII Unicode object and calls again to fill it. Exact CPython
-//! bytes inputs stay owned by the caller throughout both passes.
+//! Quoting uses a null output to request the required length, then fills an
+//! exact-size ASCII Unicode object. Unquoting fills an input-sized byte buffer
+//! once; C decodes it as UTF-8 with replacement. CPython owns every input and
+//! output object across these calls.
 #![no_std]
 
 use core::panic::PanicInfo;
@@ -73,3 +74,44 @@
     }
     written as isize
 }
+
+#[inline]
+fn hex_value(c: u8) -> Option<u8> {
+    match c {
+        b'0'..=b'9' => Some(c - b'0'),
+        b'a'..=b'f' => Some(c - b'a' + 10),
+        b'A'..=b'F' => Some(c - b'A' + 10),
+        _ => None,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn unquote_ascii(
+    input: *const u8,
+    input_len: usize,
+    output: *mut u8,
+    capacity: usize,
+) -> isize {
+    if input.is_null() || output.is_null() || capacity < input_len || input_len > isize::MAX as usize {
+        return -1;
+    }
+    let mut read = 0;
+    let mut written = 0;
+    while read < input_len {
+        let c = unsafe { *input.add(read) };
+        if c == b'%' && input_len - read >= 3 {
+            let high = hex_value(unsafe { *input.add(read + 1) });
+            let low = hex_value(unsafe { *input.add(read + 2) });
+            if let (Some(high), Some(low)) = (high, low) {
+                unsafe { *output.add(written) = (high << 4) | low; }
+                read += 3;
+                written += 1;
+                continue;
+            }
+        }
+        unsafe { *output.add(written) = c; }
+        read += 1;
+        written += 1;
+    }
+    written as isize
+}
