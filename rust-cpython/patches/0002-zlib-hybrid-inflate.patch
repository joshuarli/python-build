diff --git a/Modules/zlibmodule.c b/Modules/zlibmodule.c
--- a/Modules/zlibmodule.c
+++ b/Modules/zlibmodule.c
@@ -11,6 +11,21 @@
 #include "stdbool.h"
 #include <stddef.h>               // offsetof()
 
+/* Keep deflate, checksums, and zlibVersion on platform zlib. The prefixed
+   zlib-rs entry points own every inflate stream, including copy and zdict. */
+#ifdef PYTHON_BUILD_ZLIB_HYBRID
+extern int python_build_rs_inflateInit2_(z_streamp, int, const char *, int);
+extern int python_build_rs_inflate(z_streamp, int);
+extern int python_build_rs_inflateEnd(z_streamp);
+extern int python_build_rs_inflateCopy(z_streamp, z_streamp);
+extern int python_build_rs_inflateSetDictionary(z_streamp, const Bytef *, uInt);
+#define inflateInit2_ python_build_rs_inflateInit2_
+#define inflate python_build_rs_inflate
+#define inflateEnd python_build_rs_inflateEnd
+#define inflateCopy python_build_rs_inflateCopy
+#define inflateSetDictionary python_build_rs_inflateSetDictionary
+#endif
+
 #if defined(ZLIB_VERNUM) && ZLIB_VERNUM < 0x1221
 #error "At least zlib version 1.2.2.1 is required"
 #endif
