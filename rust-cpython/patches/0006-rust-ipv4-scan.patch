diff --git a/Modules/_rust_ipv4_scan/module.c b/Modules/_rust_ipv4_scan/module.c
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_ipv4_scan/module.c
@@ -0,0 +1,48 @@
+/* CPython owns the Unicode object while Rust scans its ASCII storage. */
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+#include <stdint.h>
+
+extern int64_t ipv4_scan(const unsigned char *, Py_ssize_t);
+
+static PyObject *scan(PyObject *self, PyObject *arg)
+{
+    int64_t value;
+    (void)self;
+    if (!PyUnicode_CheckExact(arg)) {
+        PyErr_SetString(PyExc_TypeError, "scan requires exact str");
+        return NULL;
+    }
+    if (!PyUnicode_IS_ASCII(arg)) {
+        Py_RETURN_NONE;
+    }
+    value = ipv4_scan((const unsigned char *)PyUnicode_1BYTE_DATA(arg),
+                      PyUnicode_GET_LENGTH(arg));
+    if (value < 0) {
+        Py_RETURN_NONE;
+    }
+    return PyLong_FromUnsignedLong((unsigned long)value);
+}
+
+static PyMethodDef methods[] = {
+    {"scan", scan, METH_O, "Scan a canonical IPv4 literal or return None."},
+    {NULL, NULL, 0, NULL}
+};
+
+static PyModuleDef_Slot slots[] = {
+    {Py_mod_multiple_interpreters, Py_MOD_PER_INTERPRETER_GIL_SUPPORTED},
+    {0, NULL}
+};
+
+static struct PyModuleDef module = {
+    PyModuleDef_HEAD_INIT,
+    .m_name = "_rust_ipv4_scan",
+    .m_size = 0,
+    .m_methods = methods,
+    .m_slots = slots,
+};
+
+PyMODINIT_FUNC PyInit__rust_ipv4_scan(void)
+{
+    return PyModuleDef_Init(&module);
+}
diff --git a/Modules/_rust_ipv4_scan/scan.rs b/Modules/_rust_ipv4_scan/scan.rs
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_ipv4_scan/scan.rs
@@ -0,0 +1,60 @@
+//! Scan canonical dotted decimal IPv4 without allocating.
+#![no_std]
+
+use core::panic::PanicInfo;
+
+unsafe extern "C" {
+    fn abort() -> !;
+}
+
+#[panic_handler]
+fn panic(_info: &PanicInfo<'_>) -> ! {
+    unsafe { abort() }
+}
+
+// The C caller holds a live ASCII Unicode object for the full scan.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ipv4_scan(input: *const u8, length: isize) -> i64 {
+    if !(7..=15).contains(&length) {
+        return -1;
+    }
+    let mut value = 0u32;
+    let mut octets = 0u8;
+    let mut current = 0u16;
+    let mut digits = 0u8;
+    let mut first = 0u8;
+    let mut index = 0;
+    while index < length {
+        let byte = unsafe { *input.offset(index) };
+        if byte == b'.' {
+            if digits == 0 || octets == 3 {
+                return -1;
+            }
+            value = (value << 8) | u32::from(current);
+            octets += 1;
+            current = 0;
+            digits = 0;
+        } else if byte.is_ascii_digit() {
+            if digits == 0 {
+                first = byte;
+            } else if first == b'0' {
+                return -1;
+            }
+            digits += 1;
+            if digits > 3 {
+                return -1;
+            }
+            current = current * 10 + u16::from(byte - b'0');
+            if current > 255 {
+                return -1;
+            }
+        } else {
+            return -1;
+        }
+        index += 1;
+    }
+    if octets != 3 || digits == 0 {
+        return -1;
+    }
+    i64::from((value << 8) | u32::from(current))
+}
