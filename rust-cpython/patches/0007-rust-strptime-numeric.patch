diff --git a/Modules/_rust_strptime_numeric/module.c b/Modules/_rust_strptime_numeric/module.c
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_strptime_numeric/module.c
@@ -0,0 +1,46 @@
+/* CPython owns the exact Unicode input; Rust only scans fixed ASCII fields. */
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+#include <stdint.h>
+
+extern int strptime_numeric_scan(const unsigned char *, Py_ssize_t, uint16_t *);
+
+static PyObject *scan(PyObject *self, PyObject *arg)
+{
+    uint16_t fields[6];
+    (void)self;
+    if (!PyUnicode_CheckExact(arg)) {
+        PyErr_SetString(PyExc_TypeError, "scan requires exact str");
+        return NULL;
+    }
+    if (!PyUnicode_IS_ASCII(arg) ||
+        !strptime_numeric_scan((const unsigned char *)PyUnicode_1BYTE_DATA(arg),
+                               PyUnicode_GET_LENGTH(arg), fields)) {
+        Py_RETURN_NONE;
+    }
+    return Py_BuildValue("(iiiiii)", fields[0], fields[1], fields[2],
+                         fields[3], fields[4], fields[5]);
+}
+
+static PyMethodDef methods[] = {
+    {"scan", scan, METH_O, "Return six fixed-width numeric fields or None."},
+    {NULL, NULL, 0, NULL}
+};
+
+static PyModuleDef_Slot slots[] = {
+    {Py_mod_multiple_interpreters, Py_MOD_PER_INTERPRETER_GIL_SUPPORTED},
+    {0, NULL}
+};
+
+static struct PyModuleDef module = {
+    PyModuleDef_HEAD_INIT,
+    .m_name = "_rust_strptime_numeric",
+    .m_size = 0,
+    .m_methods = methods,
+    .m_slots = slots,
+};
+
+PyMODINIT_FUNC PyInit__rust_strptime_numeric(void)
+{
+    return PyModuleDef_Init(&module);
+}
diff --git a/Modules/_rust_strptime_numeric/scan.rs b/Modules/_rust_strptime_numeric/scan.rs
new file mode 100644
--- /dev/null
+++ b/Modules/_rust_strptime_numeric/scan.rs
@@ -0,0 +1,60 @@
+#![no_std]
+
+use core::panic::PanicInfo;
+
+unsafe extern "C" {
+    fn abort() -> !;
+}
+
+#[panic_handler]
+fn panic(_info: &PanicInfo<'_>) -> ! {
+    unsafe { abort() }
+}
+
+fn digits(bytes: &[u8], start: usize, length: usize) -> Option<u16> {
+    let mut value = 0u16;
+    for &byte in &bytes[start..start + length] {
+        if !byte.is_ascii_digit() {
+            return None;
+        }
+        value = value * 10 + u16::from(byte - b'0');
+    }
+    Some(value)
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn strptime_numeric_scan(
+    input: *const u8,
+    length: isize,
+    output: *mut u16,
+) -> i32 {
+    if input.is_null() || output.is_null() || length != 19 {
+        return 0;
+    }
+    let bytes = unsafe { core::slice::from_raw_parts(input, 19) };
+    if bytes[4] != b'/' || bytes[7] != b'/' || bytes[10] != b' '
+        || bytes[13] != b':' || bytes[16] != b':' {
+        return 0;
+    }
+    let (Some(year), Some(month), Some(day), Some(hour), Some(minute), Some(second)) = (
+        digits(bytes, 0, 4), digits(bytes, 5, 2), digits(bytes, 8, 2),
+        digits(bytes, 11, 2), digits(bytes, 14, 2), digits(bytes, 17, 2),
+    ) else {
+        return 0;
+    };
+    if year == 0 || month == 0 || month > 12 || hour > 23 || minute > 59 || second > 59 {
+        return 0;
+    }
+    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+    let month_days = match month {
+        2 => 28 + u16::from(leap),
+        4 | 6 | 9 | 11 => 30,
+        _ => 31,
+    };
+    if day == 0 || day > month_days {
+        return 0;
+    }
+    let fields = [year, month, day, hour, minute, second];
+    unsafe { core::ptr::copy_nonoverlapping(fields.as_ptr(), output, 6) };
+    1
+}
