+            self.overflowed = true;
+            return;
+        }
+        self.bytes += data.len();
+        self.events.push((
+            write,
+            version,
+            content_type,
+            message_type,
+            data.to_vec(),
+        ));
+    }
+
+    fn take(&mut self) -> Option<Vec<MessageCallbackEvent>> {
+        if self.overflowed {
+            self.events.clear();
+            self.bytes = 0;
+            return None;
+        }
+        self.bytes = 0;
+        Some(core::mem::take(&mut self.events))
+    }
