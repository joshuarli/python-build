+
+impl MessageCallbackEvents {
+    fn new() -> Self {
+        Self {
+            events: Vec::new(),
+            bytes: 0,
+            overflowed: false,
+        }
+    }
+
+    fn push(
+        &mut self,
+        write: bool,
+        version: u16,
+        content_type: u16,
+        message_type: i32,
